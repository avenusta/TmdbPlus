<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>TmdbPlus</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <Version>0.2.0</Version>
        <Description>Strongly typed .NET wrapper for the TMDB API</Description>
        <Authors>avenusta</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/avenusta/TmdbPlus</PackageProjectUrl>
        <RepositoryUrl>https://github.com/avenusta/TmdbPlus</RepositoryUrl>
        <PackageTags>tmdb;movies;tv;api-client</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- SourceLink ships in the SDK since .NET 8, so no PackageReference. Symbols go as a
             separate .snupkg; nuget.org wants that format. -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
        <None Include="../LICENSE" Pack="true" PackagePath="/" />
    </ItemGroup>

    <!--
      The nswag output is reference material, not code: an index of TMDB's 152 paths and
      parameter names to consult while hand-writing an endpoint. It is not compiled because its
      methods hardcode their return type (so they cannot yield our public types), its DTOs cannot
      hold append_to_response blocks at all, and it declares 1 nullable property in 48,669 lines.
      Routing through it would drop data and cost ~5,554 mapping assignments.
      See https://github.com/avenusta/TmdbPlus/issues/9.
    -->
    <!--
      Microsoft.Extensions.Http pulls in DependencyInjection + Options and is what makes
      AddTmdb / the auth DelegatingHandler pipeline work. Not third-party: it ships with the
      platform, out of the same repo as the BCL.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="TmdbPlus.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Client/TmdbClient.Generated.cs" />
        <None Include="Client/TmdbClient.Generated.cs" />
    </ItemGroup>

</Project>
