<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>TmdbPlus</RootNamespace>
        <!-- The generated client leaves non-nullable DTO properties uninitialized; nswag owns that file. -->
        <NoWarn>$(NoWarn);CS8618</NoWarn>
    </PropertyGroup>

</Project>
